{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "anselmi-dev/sumsub",
    "description": "Sumsub KYC integration package for Laravel with webhook processing and event notifications",
    "type": "library",
    "keywords": ["laravel", "kyc", "sumsub", "identity-verification", "webhook", "event"],
    "license": "MIT",
    "authors": [
        {
            "name": "AnselmiDev",
            "email": "anselmi.dev@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/queue": "^11.0|^12.0|^13.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "AnselmiDev\\Sumsub\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AnselmiDev\\Sumsub\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AnselmiDev\\Sumsub\\SumsubServiceProvider"
            ],
            "aliases": {
                "Sumsub": "AnselmiDev\\Sumsub\\Facades\\Sumsub"
            }
        },
        "branch-alias": {
            "dev-master": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    }
}
